<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000F1F"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CESARINMAX QR"
        android:textColor="#00CCFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="50dp"/>

    <!-- BOTÓN ESCANEAR CÁMARA -->
    <Button
        android:id="@+id/btnEscanear"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="📷 ESCANEAR CÓDIGO QR"
        android:textSize="18sp"
        android:background="#1A73E8"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="35dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="o escribe el código"
        android:textColor="#888888"
        android:layout_marginBottom="15dp"/>

    <!-- RECUADRO PARA ESCRIBIR -->
    <EditText
        android:id="@+id/etCodigo"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:hint="000000"
        android:maxLength="6"
        android:inputType="number"
        android:gravity="center"
        android:textSize="26sp"
        android:letterSpacing="0.2"
        android:background="#0A1929"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="35dp"/>

    <!-- BOTÓN CONECTAR -->
    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="✅ CONECTAR"
        android:textSize="18sp"
        android:background="#009933"
        android:textColor="#FFFFFF"/>

</LinearLayout>
